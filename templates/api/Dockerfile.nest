# Modelo para uma API em NestJS. Copie para a raiz do repositório da API como "Dockerfile".
# Ajuste a versão do Node. A aplicação deve ouvir em process.env.PORT (8080) e escutar em 0.0.0.0.
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build && npm prune --omit=dev

FROM node:22-alpine
ENV NODE_ENV=production PORT=8080
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./
USER node
EXPOSE 8080
CMD ["node", "dist/main.js"]
