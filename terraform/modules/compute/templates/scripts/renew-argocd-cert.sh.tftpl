#!/bin/bash
# Emite/renova o certificado TLS do ArgoCD e o entrega ao argocd-server
# (o server usa o Secret "argocd-server-tls" automaticamente quando ele existe).
#   - com domínio próprio: certbot + DNS-01 na Cloudflare
#   - sem domínio: `tailscale cert` (nome <host>.<tailnet>.ts.net)
set -euo pipefail

kubectl() { k3s kubectl "$@"; }

DOMAIN='${domain}'
ACME_EMAIL='${acme_email}'

if [ -n "$DOMAIN" ]; then
  CRED=/etc/letsencrypt/cloudflare.ini
  if [ ! -f "$CRED" ]; then
    echo "Falta $CRED (conteúdo: dns_cloudflare_api_token = <token>, modo 600). Veja o README." >&2
    exit 1
  fi
  if [ -n "$ACME_EMAIL" ]; then EMAIL_OPT="-m $ACME_EMAIL"; else EMAIL_OPT="--register-unsafely-without-email"; fi

  # Só renova quando faltam menos de 30 dias; é seguro rodar todo dia
  certbot certonly --non-interactive --agree-tos $EMAIL_OPT \
    --dns-cloudflare --dns-cloudflare-credentials "$CRED" \
    --dns-cloudflare-propagation-seconds 30 \
    -d "$DOMAIN"

  NAME="$DOMAIN"
  CERT="/etc/letsencrypt/live/$DOMAIN/fullchain.pem"
  KEY="/etc/letsencrypt/live/$DOMAIN/privkey.pem"
else
  DIR=/var/lib/argocd-tls
  install -d -m 700 "$DIR"
  NAME=$(tailscale status --json | jq -r '.Self.DNSName | rtrimstr(".")')
  tailscale cert --cert-file "$DIR/tls.crt" --key-file "$DIR/tls.key" "$NAME"
  CERT="$DIR/tls.crt"
  KEY="$DIR/tls.key"
fi

# Só mexe no cluster (e reinicia o server) quando o certificado mudou
NEW=$(sha256sum "$CERT" | cut -d' ' -f1)
CUR=$(kubectl -n argocd get secret argocd-server-tls \
  -o jsonpath='{.metadata.annotations.cert-sha256}' 2>/dev/null || true)

if [ "$NEW" != "$CUR" ]; then
  kubectl -n argocd create secret tls argocd-server-tls \
    --cert="$CERT" --key="$KEY" --dry-run=client -o yaml | kubectl apply -f -
  kubectl -n argocd annotate secret argocd-server-tls cert-sha256="$NEW" --overwrite
  kubectl -n argocd rollout restart deploy/argocd-server
  echo "certificado de $NAME atualizado"
fi
