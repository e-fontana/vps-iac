#cloud-config
package_update: true
package_upgrade: true

packages:
  - curl
  - iptables-persistent

write_files:
  - path: /usr/local/sbin/bootstrap-node.sh
    permissions: "0700"
    content: |
      ${indent(6, script)}
  - path: /var/lib/bootstrap/root-app.yaml
    permissions: "0600"
    content: |
      ${indent(6, root_app)}

runcmd:
  - /usr/local/sbin/bootstrap-node.sh
